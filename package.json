{
  "name": "telegram-social-fix-embed-bot",
  "version": "0.1.0",
  "description": "Telegram bot that rewrites social media links to public embed fixers and cleans tracking parameters.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
