# Required: token from @BotFather
BOT_TOKEN=

# Optional: how the bot's reply is formatted. One of:
#   compact    -> "📸 Instagram · enviado por Louan" + link
#   structured -> "🔗 Link Corrigido" / "👤 Enviado por: Louan" + emoji + link
#   quote      -> same info inside a Telegram blockquote card + link
MESSAGE_STYLE=compact

# Optional: which action buttons appear under each reply. The "Original"
# button is always shown and cannot be turned off. Set either to false to
# drop that button; disabling both leaves only "Original".
SHOW_REFRESH_BUTTON=true
SHOW_DELETE_BUTTON=true

# Optional: override the embed-fixer domains this bot rewrites links to.
# Change these if a public instance goes down or you self-host your own.
TWITTER_FIX_DOMAIN=fixupx.com
BLUESKY_FIX_DOMAIN=fxbsky.app
TIKTOK_FIX_DOMAIN=tfxktok.com

# Instagram takes a comma-separated LIST, tried in order: these backends get
# blocked and replaced often (ddinstagram.com died when InstaFix was archived).
# The bot probes them against the actual post and uses the first that serves
# an embed, remembering the winner for 10 minutes.
INSTAGRAM_FIX_DOMAINS=n.zzinstagram.com,eeinstagram.com,kkinstagram.com,uuinstagram.com,vxinstagram.com

# Reddit uses the same list-with-failover mechanism. rxddit.com is fxreddit's
# own instance and is tried first, but it has been intermittently unable to
# reach Reddit, so working alternatives follow it.
REDDIT_FIX_DOMAINS=rxddit.com,vxreddit.com,redditfix.com

# Optional: leave empty to skip YouTube domain rewriting (link is only
# de-tracked, not proxied through a third-party embed fixer).
YOUTUBE_FIX_DOMAIN=koutube.com

# Optional: how long (in minutes) a bot message keeps its
# refresh/delete buttons working before its state expires. Default: 1440 (24h)
STATE_TTL_MINUTES=1440

# Optional: when "true", the bot only processes messages from chats listed
# in ALLOWED_CHAT_IDS (plus OWNER_USER_ID, in any chat). When "false"
# (default), the bot responds anywhere it's added.
RESTRICT_ACCESS=false

# Comma-separated chat ids allowed when RESTRICT_ACCESS=true. Group and
# supergroup ids are negative numbers - forward any message from the group
# to @RawDataBot to see its id, or check this bot's console log.
ALLOWED_CHAT_IDS=

# Optional: your own Telegram user id. Always allowed regardless of
# RESTRICT_ACCESS/ALLOWED_CHAT_IDS - lets you keep testing in DMs or other
# groups without opening the bot up to everyone. Also unlocks /id, which
# reports the current chat's id so you can fill in ALLOWED_CHAT_IDS.
OWNER_USER_ID=

# Optional: when access is restricted, immediately leave any group the bot
# is added to that isn't in ALLOWED_CHAT_IDS. Default: true
AUTO_LEAVE_UNAUTHORIZED=true

# Optional: a message with many links is answered in batches of BATCH_SIZE
# replies, pausing BATCH_COOLDOWN_SECONDS between batches to stay under
# Telegram's flood limits. MAX_LINKS_PER_MESSAGE caps how many links from
# a single message the bot will ever process.
BATCH_SIZE=10
BATCH_COOLDOWN_SECONDS=5
MAX_LINKS_PER_MESSAGE=50
