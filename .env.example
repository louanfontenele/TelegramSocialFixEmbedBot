# Required: token from @BotFather
BOT_TOKEN=

# Optional: override the embed-fixer domains this bot rewrites links to.
# Change these if a public instance goes down or you self-host your own.
TWITTER_FIX_DOMAIN=fixupx.com
BLUESKY_FIX_DOMAIN=fxbsky.app
INSTAGRAM_FIX_DOMAIN=ddinstagram.com
TIKTOK_FIX_DOMAIN=tfxktok.com

# Optional: leave empty to skip YouTube domain rewriting (link is only
# de-tracked, not proxied through a third-party embed fixer).
YOUTUBE_FIX_DOMAIN=koutube.com

# Optional: how long (in minutes) a bot message keeps its
# refresh/delete buttons working before its state expires. Default: 1440 (24h)
STATE_TTL_MINUTES=1440
